PORT=4000
DB_HOST=localhost
DB_NAME=ecommerce_central
DB_USER=root
DB_PASS=
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

# eBay app credentials: for Browse API app token + OAuth refresh
EBAY_CLIENT_ID=YOUR_EBAY_CLIENT_ID
EBAY_CLIENT_SECRET=YOUR_EBAY_CLIENT_SECRET

# eBay Trading API token: own item watch count + own item transactions
EBAY_TRADING_TOKEN=YOUR_EBAY_TRADING_TOKEN

# Recommended for Sell APIs: Fulfillment, Analytics, Marketing, Inventory, Finances
# Use refresh token for long-term production. Temporary user access token is only for testing.
EBAY_REFRESH_TOKEN=YOUR_EBAY_REFRESH_TOKEN
EBAY_USER_ACCESS_TOKEN=

# Gemini for AI title/keyword generation
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Optional tuning
CRON_DAILY_SCHEDULE="30 0 * * *"
TRACKER_BATCH_SIZE=50
